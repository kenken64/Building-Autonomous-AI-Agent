# --- OpenRouter credentials -------------------------------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Model ------------------------------------------------------------------
# Qwen3.7 Flash via OpenRouter. Overrides default_model in
# hermes_a2a_config.json. Chosen for cost: a six-agent run costs about $0.0014
# against $0.147 on moonshotai/kimi-k3 -- roughly 100x cheaper for the same
# grounded answers. Verified alternatives: deepseek/deepseek-v4-flash-0731,
# openai/gpt-oss-120b (see the lab README for what each was tested on).
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_TEMPERATURE=0.2
# Qwen3.7 Flash reasons before it answers, and reasoning shares this budget with
# the visible reply. 1200 was not enough: reasoning consumed it and some agents
# returned nothing at all. Keep this generous for any reasoning model.
OPENROUTER_MAX_TOKENS=6000
# Reasoning effort: none | low | medium | high | default.
# 'medium' is the workshop default: measured fastest AND cheapest of the three
# levels on this lab's prompts. See BENCHMARK.md.
OPENROUTER_REASONING_EFFORT=medium

# --- Attribution shown on the OpenRouter dashboard --------------------------
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=AgentMart Workshop
