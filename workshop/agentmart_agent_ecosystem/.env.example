# --- OpenRouter credentials -------------------------------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Model ------------------------------------------------------------------
# Kimi K3 (Moonshot AI) via OpenRouter. Overrides default_model in
# hermes_a2a_config.json. Alternatives: moonshotai/kimi-k2.6,
# moonshotai/kimi-k2-0905, moonshotai/kimi-k2-thinking
OPENROUTER_MODEL=moonshotai/kimi-k3
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=1200

# --- Attribution shown on the OpenRouter dashboard --------------------------
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=AgentMart Workshop
